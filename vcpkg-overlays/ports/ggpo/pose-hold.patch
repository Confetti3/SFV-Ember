+
+bool
+Sync::CanHold(int frame)
+{
+   if (frame < 1 || frame > _framecount) {
+      return false;
+   }
+   if (FindSavedFrameIndexOrNone(frame - 1) < 0) {
+      return false;
+   }
+   for (int i = 0; i < _config.num_players; i++) {
+      /* SynchronizeInputs gives a dropped player's frames after its last as erased. */
+      if (_local_connect_status[i].disconnected && frame - 1 > _local_connect_status[i].last_frame) {
+         continue;
+      }
+      if (!_input_queues[i].CanGetInput(frame - 1)) {
+         return false;
+      }
+   }
+   return true;
+}
+
+int
+Sync::Hold(int frame)
+{
+   if (_rollingback || !CanHold(frame)) {
+      return -1;
+   }
+   int seek_to;
+   if (!CheckSimulationConsistency(&seek_to)) {
+      /* A misprediction the last poll did not roll back: never expected here. */
+      return -1;
+   }
+   /* Held again before the replay: it still reaches the same frame. */
+   int resume_to = _held_to >= 0 ? _held_to : _framecount;
+   if (frame > resume_to) {
+      return -1;
+   }
+
+   Log("Pose hold at frame %d: replaying %d now, %d to %d next.\n", frame, frame - 1, frame, resume_to - 1);
+   _held_to = -1;
+   _rollingback = true;
+   LoadFrame(frame - 1);
+   ASSERT(_framecount == frame - 1);
+   ResetPrediction(_framecount);
+   _callbacks.advance_frame(0);
+   ASSERT(_framecount == frame);
+   _rollingback = false;
+
+   if (_framecount < resume_to) {
+      _held_to = resume_to;
+   }
+   return resume_to - _framecount;
+}
+
+bool
+Sync::ResumeHold()
+{
+   if (_held_to < 0 || _rollingback) {
+      return false;
+   }
+   int to = _held_to;
+   _held_to = -1;
+   Log("Resuming a pose hold: frames %d to %d.\n", _framecount, to - 1);
+   _rollingback = true;
+   while (_framecount < to) {
+      int before = _framecount;
+      _callbacks.advance_frame(0);
+      if (_framecount == before) {
+         ASSERT(FALSE); /* the callback did not advance */
+         break;
+      }
+   }
+   _rollingback = false;
+   return true;
+}
