 GGPOErrorCode
+Peer2PeerBackend::GetConfirmedInputFrame(int *frame)
+{
+   /*
+    * What Poll2Players would confirm now, without polling: the least last
+    * frame of the players still connected.  With more than two players the
+    * endpoints' views count too (PollNPlayers), so the last poll's number
+    * is given instead.
+    */
+   int confirmed = MAX_INT;
+   if (_num_players <= 2) {
+      for (int i = 0; i < _num_players; i++) {
+         if (!_local_connect_status[i].disconnected) {
+            confirmed = MIN(_local_connect_status[i].last_frame, confirmed);
+         }
+      }
+   }
+   *frame = confirmed == MAX_INT ? _sync.GetLastConfirmedFrame() : confirmed;
+   return GGPO_OK;
+}
