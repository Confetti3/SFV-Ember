+
+/*
+ * Read-only, game-thread accessor for the last frame whose inputs every
+ * connected player has given as of now: the local players' as added, the
+ * remote players' as received by the last poll, which also rolled back any
+ * misprediction among them.  ggpo_get_last_confirmed_frame is the same
+ * number as of the last poll; this one also counts the inputs added since,
+ * so it is never behind it.  A rollback starts after it, and a dropped
+ * peer's resimulation no earlier than it.  Returns -1 until input is
+ * confirmed; backends other than peer-to-peer return UNSUPPORTED.  This
+ * call does not poll, advance, or change pacing.
+ */
+GGPO_API GGPOErrorCode __cdecl ggpo_get_confirmed_input_frame(GGPOSession *,
+                                                            int *frame);
 
