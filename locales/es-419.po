msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es-419\n"

msgid "app.name"
msgstr "SFV Ember"

msgid "shell.home_title"
msgstr "SFV EMBER"

msgid "screen.game"
msgstr "SFV"

msgid "about.version_line"
msgstr "SFV Ember {0} · {1}"

msgid "brand.subtitle"
msgstr "SFV  /  SALAS Y ROLLBACK NETPLAY"

msgid "about.ember_detail"
msgstr "Mod no oficial de Street Fighter V, creado sobre Ember (basado en sf4e de Anthony Danducci). Iroh / QUIC, GGPO, Dear ImGui y tipografía Inter. Compilación: {0}"

msgid "runtime.open_shortcut"
msgstr "SFV Ember  /  F10 o Start"

msgid "runtime.build_mismatch"
msgstr "Versiones diferentes. Ambos jugadores deben usar la misma compilación de SFV Ember y los mismos luchadores y escenarios instalados."

msgid "runtime.room_join_failed"
msgstr "No se pudo entrar a la sala. Revisa la invitación y que ambos jugadores usen la misma compilación de SFV Ember."

msgid "selection.not_owned"
msgstr "No lo tienes en esta copia de Street Fighter V."

msgid "runtime.invite_other_build"
msgstr "El anfitrión usa otra compilación de SFV Ember. Ambos jugadores necesitan la misma versión."

msgid "about.controls_detail"
msgstr "Control: A selecciona y B vuelve atrás. Teclado: flechas, Enter y Escape. La cruceta mueve; Izquierda y Derecha cambian un valor. Volver atrás en Inicio oculta SFV Ember. F10, o Start en el control, lo abre de nuevo en el menú principal del juego.\n\nEn una sala, A sobre una mesa permite elegir asiento, A en tu asiento te marca como listo y B abandona tu asiento o lugar en la cola. X abre Luchador, Y Opciones y View Chat; pulsa de nuevo para volver a la sala.\n\nEl entrenamiento es el propio de Street Fighter V: su menú de pausa configura el muñeco, la grabación y los datos de frames. Cuando un oponente te llama de vuelta a tu sala, View en el control o Enter te lleva de inmediato."

msgid "launcher.steam_runs_as_admin"
msgstr "Street Fighter V no pudo conectarse a Steam porque Steam se está ejecutando como administrador. Cierra Steam, ábrelo normalmente y vuelve a intentarlo. Iniciar SFV Ember como administrador también funciona, pero así no se instalan las actualizaciones."

msgid "launcher.game_blocked_by_windows"
msgstr "Windows bloqueó uno de los archivos del juego antes de que SFV Ember pudiera iniciarse (control de aplicaciones). El Control inteligente de aplicaciones no puede permitir un solo programa: si está activado en Seguridad de Windows, SFV Ember solo funcionará cuando lo desactives. En una PC administrada por una organización, pide a su administrador que permita SFV Ember."

msgid "launcher.update_failed"
msgstr "No se pudo instalar la actualización. Cierra el juego y el iniciador anterior antes de volver a intentarlo. Consulta %TEMP%\\sfv-ember-update.log; las copias conservadas están en .ember-update-backups."

msgid "launcher.recovery_opened"
msgstr "La red no estaba disponible, así que Street Fighter V se cerró para la recuperación. Reintentar inicio lo abre de nuevo."

msgid "launcher.game_not_found"
msgstr "No se encontró Street Fighter V."

msgid "launcher.sidecar_missing"
msgstr "Falta sfv_ember.dll o el inyector no puede usar su ruta. Extrae el paquete completo en una ruta local sencilla."

msgid "launcher.runtime_outdated"
msgstr "Tu runtime de Microsoft Visual C++ está desactualizado y el juego fallaría al iniciar. Instala la versión más reciente de Visual C++ Redistributable (x64) y vuelve a iniciar SFV Ember.\n\n¿Abrir ahora la página de descarga?"

msgid "launcher.already_running"
msgstr "SFV Ember ya se está ejecutando. Si no lo ves, cierra Launcher.exe y StreetFighterV.exe en el Administrador de tareas y vuelve a iniciar SFV Ember."

msgid "launcher.start_failed"
msgstr "No se pudo iniciar o inyectar el juego. Revisa el registro del iniciador en %APPDATA%\\SFVEmber\\logs\\launcher.log y vuelve a intentarlo."

msgid "launcher.game_runs_as_admin"
msgstr "StreetFighterV.exe está configurado para ejecutarse como administrador, así que SFV Ember no puede iniciarlo. Haz clic derecho en StreetFighterV.exe en la carpeta StreetFighterV\\Binaries\\Win64 del juego, abre Propiedades y luego Compatibilidad, y desmarca \"Ejecutar este programa como administrador\", también en \"Cambiar la configuración para todos los usuarios\". Luego vuelve a intentarlo."

msgid "launcher.game_error"
msgstr "El juego terminó con un error. Revisa el registro del iniciador en %APPDATA%\\SFVEmber\\logs\\launcher.log y vuelve a intentarlo."

msgid "launcher.game_crashed"
msgstr "El juego falló. Para ayudar a corregirlo, elige Enviar este reporte abajo. O envía tú mismo los archivos de %APPDATA%\\SFVEmber\\logs."

msgid "launcher.game_wrong_dll"
msgstr "El juego se detuvo antes de que SFV Ember pudiera iniciar porque a una DLL que cargó le falta una función. Envía el registro del iniciador (%APPDATA%\\SFVEmber\\logs\\launcher.log)."

msgid "launcher.game_crashed_files"
msgstr "El juego falló. Envía al equipo de SFV Ember los archivos de %APPDATA%\\SFVEmber\\logs (sfv_ember.log y launcher.log, y sfv_ember-crash-*.dmp si hay uno) y vuelve a intentarlo."

msgid "launcher.game_crashed_sending"
msgstr "El juego falló. Enviar reportes de problemas está activado, así que se está enviando su reporte, con el volcado pequeño si el fallo lo generó. Los archivos también están en %APPDATA%\\SFVEmber\\logs."

msgid "recovery.d3d_failed"
msgstr "No se pudo iniciar la interfaz de recuperación con Direct3D 9. Consulta %APPDATA%\\SFVEmber\\logs\\launcher.log."

msgid "recovery.choose_folder_title"
msgstr "Selecciona la carpeta que contiene StreetFighterV.exe (StreetFighterV\\Binaries\\Win64)"

msgid "recovery.folder_invalid"
msgstr "Esa carpeta no contiene StreetFighterV.exe. Elige la carpeta StreetFighterV\\Binaries\\Win64 del juego."

msgid "recovery.choose_folder_detail"
msgstr "Selecciona la carpeta de instalación de Street Fighter V que contiene StreetFighterV.exe: StreetFighterV\\Binaries\\Win64 dentro de la carpeta del juego. Los archivos del juego no se incluyen en este paquete."

msgid "recovery.close_detail"
msgstr "Cierra la recuperación sin iniciar Street Fighter V. Se cancelarán las operaciones en curso."

msgid "updates.install_detail"
msgstr "Cierra Street Fighter V antes de instalar. El paquete se verifica antes de la instalación. Se conservarán tus ajustes personales."

msgid "updates.close_detail"
msgstr "Cierra el actualizador sin iniciar Street Fighter V. Se cancelarán las operaciones en curso."

msgid "updates.start_game"
msgstr "Iniciar Street Fighter V"

msgid "updates.start_game_detail"
msgstr "Cierra el actualizador e inicia Street Fighter V con SFV Ember."

msgid "services.diagnostics_saved"
msgstr "Guardado en %APPDATA%\\SFVEmber\\diagnostics\\ember-diagnostics.txt"

msgid "services.update_prepared"
msgstr "Actualización preparada. Reiniciando SFV Ember..."

msgid "update.no_zip_asset"
msgstr "La versión más reciente no tiene un ZIP de SFV Ember."

msgid "update.close_sf4"
msgstr "Cierra Street Fighter V antes de instalar una actualización."

msgid "update.download_failed"
msgstr "Falló la descarga ({0}). Descarga manual: {1} (detalles en %TEMP%\\sfv-ember-update.log)"

msgid "update.missing_binaries"
msgstr "Al paquete descargado le falta Launcher.exe o sfv_ember.dll."

msgid "update.notice.waiting_launcher"
msgstr "Esperando a que se cierre SFV Ember..."

msgid "update.notice.reopens"
msgstr "SFV Ember se abrirá de nuevo al terminar."

msgid "reports.payload"
msgstr "Los reportes van a embernetplay.link. Cada uno incluye la versión y la compilación de SFV Ember, la versión de Windows, los datos del fallo, el final censurado de sfv_ember.log, launcher.log y sf4-net.log, y el volcado pequeño si el fallo generó uno."

msgid "reports.history_unreadable_detail"
msgstr "No se puede leer sent-reports.json en %APPDATA%\\SFVEmber, así que no se envía ningún reporte sin preguntar. Borra el archivo para empezar un historial nuevo."

msgid "home.replays_detail"
msgstr "Tus partidas de sala, guardadas al terminar cada pelea. Míralas de nuevo en Street Fighter V."

msgid "replays.empty_detail"
msgstr "Una partida de sala se guarda aquí cuando termina su pelea."

msgid "replays.watch_detail"
msgstr "Reproduce su pelea de nuevo en Street Fighter V, desde el principio."

msgid "replays.row_detail"
msgstr "Selecciona para verla, conservarla o mostrar su archivo."

msgid "replays.open_folder_detail"
msgstr "Abre la carpeta de repeticiones en el Explorador."

msgid "inputs.unreadable_detail"
msgstr "Esta repetición no se puede reproducir: su archivo está dañado o la creó otra compilación de SFV Ember. El registro indica el motivo."

msgid "replays.not_added"
msgstr "Esta repetición no se reprodujo hasta el final. El registro indica el motivo."

msgid "home.training_detail"
msgstr "Entra al modo Entrenamiento de Street Fighter V con tu luchador, contra el muñeco que elijas."

msgid "room.practice.detail"
msgstr "Cada partida de la sala es una partida de práctica: la salud y las barras se rellenan, nadie queda fuera de combate y no hay límite de tiempo. Esto se mantiene mientras la sala esté abierta. Para jugar partidas normales, cierra la sala y crea una nueva."

msgid "selection.ultra_combo"
msgstr "V-Skill y V-Trigger"

msgid "selection.ultra_combo_title"
msgstr "V-SKILL Y V-TRIGGER"

msgid "selection.ultra_row.detail"
msgstr "Izquierda y Derecha cambian aquí V-Skill y V-Trigger. Seleccionar muestra cada opción con su técnica."

msgid "room.ultra.detail"
msgstr "Elige aquí tu V-Skill y tu V-Trigger para la siguiente partida, sin abrir las Opciones de la mesa."

msgid "room.ultra.single"
msgstr "Este luchador solo tiene una opción de V-Skill y una de V-Trigger."

msgid "postmatch.ultra.detail"
msgstr "Izquierda y Derecha cambian tu V-Skill y tu V-Trigger para la siguiente partida. Con una opción nueva, la siguiente partida carga primero."

msgid "postmatch.ultra.set"
msgstr "Ya elegiste tu V-Skill y tu V-Trigger para la siguiente partida."

msgid "room.opponent_changed_fighter"
msgstr "Tu oponente cambió a {0}. Revisa tu V-Skill y tu V-Trigger antes de marcar Listo."

msgid "room.change_fighter.detail"
msgstr "Elige un luchador y luego su V-Skill y su V-Trigger. Vuelve y marca Listo."

msgid "runtime.ready.selection_unavailable"
msgstr "Esta selección de luchador no está disponible. Elige un traje, color, V-Skill y V-Trigger disponibles."

msgid "runtime.selection_combination_unavailable"
msgstr "Esta combinación no está disponible con las reglas de la sala. Elige otro luchador, traje, color, V-Skill o V-Trigger."

msgid "selection.winner_keeps_fighter"
msgstr "Ganaste el último set, así que conservas este luchador. Todavía puedes cambiar V-Skill, V-Trigger, traje y color."

msgid "rules.winner_keeps_fighter.detail"
msgstr "Como en un arcade de verdad, quien gana el set sigue con el luchador con el que ganó. Solo pueden cambiar V-Skill, V-Trigger, traje y color."

msgid "menu.hint.save_ultra"
msgstr "Guardar V-Skill y V-Trigger"

msgid "training.close_controls.detail"
msgstr "Cierra Ember y luego el menú de pausa de SFV para continuar, si está abierto."

msgid "controllers.detail_steam"
msgstr "Steam Input gestiona este control, por lo que sus botones siguen tu configuración de Steam. Para que Ember lo gestione, inicia Ember fuera de Steam o desactiva Steam Input para Street Fighter V en Steam."
