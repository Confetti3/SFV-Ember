"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

msgid "app.name"
msgstr "SFV Ember"

msgid "shell.home_title"
msgstr "SFV EMBER"

msgid "screen.game"
msgstr "SFV"

msgid "about.version_line"
msgstr "SFV Ember {0} · {1}"

msgid "brand.subtitle"
msgstr "SFV  /  방 및 롤백 넷플레이"

msgid "about.ember_detail"
msgstr "Ember를 기반으로 만든 비공식 Street Fighter V 모드입니다(Anthony Danducci의 sf4e를 바탕으로 함). Iroh / QUIC, GGPO, Dear ImGui 및 Inter 서체를 사용합니다. 빌드: {0}"

msgid "runtime.open_shortcut"
msgstr "SFV Ember  /  F10 또는 Start"

msgid "runtime.build_mismatch"
msgstr "빌드가 다릅니다. 두 플레이어가 같은 SFV Ember 빌드를 사용하고, 설치된 파이터와 스테이지도 같아야 합니다."

msgid "runtime.room_join_failed"
msgstr "방에 참가하지 못했습니다. 초대와 두 플레이어의 SFV Ember 빌드가 같은지 확인하세요."

msgid "selection.not_owned"
msgstr "이 Street Fighter V에서는 보유하지 않았습니다."

msgid "runtime.invite_other_build"
msgstr "호스트가 다른 SFV Ember 빌드를 사용 중입니다. 두 플레이어 모두 같은 버전이 필요합니다."

msgid "about.controls_detail"
msgstr "컨트롤러: A로 선택하고 B로 돌아갑니다. 키보드: 방향키, Enter, Escape. 방향 패드로 이동하고 왼쪽과 오른쪽으로 값을 바꿉니다. 홈에서 돌아가면 SFV Ember가 숨겨집니다. 게임 메인 메뉴에서 F10 또는 컨트롤러의 Start를 누르면 다시 열립니다.\n\n방에서는 테이블에서 A를 눌러 자리를 고르고 자기 자리에서 A를 눌러 준비합니다. B를 누르면 자리나 대기열에서 나갑니다. X는 파이터, Y는 옵션, View는 채팅을 엽니다. 다시 누르면 방으로 돌아갑니다.\n\n훈련은 Street Fighter V 자체의 것입니다. 일시정지 메뉴에서 더미, 녹화, 프레임 데이터를 설정합니다. 상대가 나를 방으로 다시 부르면 컨트롤러의 View 또는 Enter로 바로 돌아갈 수 있습니다."

msgid "runtime.selection_combination_unavailable"
msgstr "이 조합은 방 규칙에서 사용할 수 없습니다. 다른 캐릭터, 코스튬, 색상, V스킬 또는 V트리거를 선택하세요."

msgid "runtime.ready.selection_unavailable"
msgstr "이 캐릭터 선택을 사용할 수 없습니다. 사용 가능한 코스튬, 색상, V스킬 및 V트리거를 고르세요."

msgid "room.opponent_changed_fighter"
msgstr "상대가 {0}(으)로 바꿨습니다. 준비하기 전에 V스킬과 V트리거를 확인하세요."

msgid "room.change_fighter.detail"
msgstr "캐릭터를 선택한 뒤 V스킬과 V트리거를 고르세요. 여기로 돌아와 준비를 선택하세요."

msgid "rules.winner_keeps_fighter.detail"
msgstr "실제 오락실처럼 세트 승자는 이긴 캐릭터로 계속합니다. V스킬, V트리거, 코스튬, 색상만 바꿀 수 있습니다."

msgid "selection.winner_keeps_fighter"
msgstr "지난 세트에서 이겼으므로 이 캐릭터를 유지합니다. V스킬, V트리거, 코스튬, 색상은 계속 바꿀 수 있습니다."

msgid "launcher.steam_runs_as_admin"
msgstr "Steam이 관리자 권한으로 실행 중이어서 Street Fighter V가 Steam에 연결하지 못했습니다. Steam을 종료하고 일반 방식으로 다시 실행한 뒤 다시 시도하세요. SFV Ember를 관리자 권한으로 실행해도 되지만, 그러면 업데이트가 설치되지 않습니다."

msgid "launcher.game_blocked_by_windows"
msgstr "SFV Ember가 시작되기 전에 Windows가 게임 파일을 차단했습니다(앱 제어). 스마트 앱 컨트롤은 프로그램 하나만 허용할 수 없습니다. Windows 보안에서 켜져 있으면 끄고 나서 SFV Ember를 실행할 수 있습니다. 관리되는 PC라면 관리자에게 SFV Ember 허용을 요청하세요."

msgid "launcher.update_failed"
msgstr "업데이트를 설치하지 못했습니다. 게임과 이전 런처를 닫고 다시 시도하세요. %TEMP%\\sfv-ember-update.log를 확인하세요. 보존된 제품 사본은 .ember-update-backups에 있습니다."

msgid "launcher.recovery_opened"
msgstr "네트워크를 사용할 수 없어 Street Fighter V를 복구를 위해 닫았습니다. 실행 재시도로 다시 시작할 수 있습니다."

msgid "launcher.game_not_found"
msgstr "Street Fighter V를 찾을 수 없습니다."

msgid "launcher.sidecar_missing"
msgstr "sfv_ember.dll이 없거나 인젝터에서 해당 경로를 사용할 수 없습니다. 전체 패키지를 간단한 로컬 경로에 압축 해제하세요."

msgid "launcher.runtime_outdated"
msgstr "Microsoft Visual C++ 런타임이 오래되어 게임 실행 시 종료됩니다. 최신 Visual C++ Redistributable (x64)을 설치한 뒤 SFV Ember를 다시 시작하세요.\n\n지금 다운로드 페이지를 여시겠습니까?"

msgid "launcher.already_running"
msgstr "SFV Ember가 이미 실행 중입니다. 창이 보이지 않으면 작업 관리자에서 Launcher.exe와 StreetFighterV.exe를 종료한 뒤 SFV Ember를 다시 시작하세요."

msgid "launcher.start_failed"
msgstr "게임 실행 또는 인젝션에 실패했습니다. 런처 로그(%APPDATA%\\SFVEmber\\logs\\launcher.log)를 확인하고 다시 시도하세요."

msgid "launcher.game_runs_as_admin"
msgstr "StreetFighterV.exe가 관리자 권한으로 실행되도록 설정되어 있어 SFV Ember에서 시작할 수 없습니다. 게임의 StreetFighterV\\Binaries\\Win64 폴더에서 StreetFighterV.exe를 마우스 오른쪽 버튼으로 클릭하고 속성의 호환성 탭을 연 뒤 \"관리자 권한으로 이 프로그램 실행\"을 해제하세요. \"모든 사용자 설정 변경\" 안에서도 해제해야 합니다. 그런 다음 다시 시도하세요."

msgid "launcher.game_error"
msgstr "게임이 오류로 종료되었습니다. 런처 로그(%APPDATA%\\SFVEmber\\logs\\launcher.log)를 확인하고 다시 시도하세요."

msgid "launcher.game_crashed"
msgstr "게임이 충돌했습니다. 문제 해결을 도우려면 아래에서 이 보고서 보내기를 선택하세요. %APPDATA%\\SFVEmber\\logs 폴더의 파일을 직접 보내도 됩니다."

msgid "launcher.game_wrong_dll"
msgstr "불러온 DLL에 필요한 함수가 없어 SFV Ember 시작 전에 게임이 종료되었습니다. 런처 로그(%APPDATA%\\SFVEmber\\logs\\launcher.log)를 보내주세요."

msgid "launcher.game_crashed_files"
msgstr "게임이 충돌했습니다. %APPDATA%\\SFVEmber\\logs 폴더의 파일(sfv_ember.log, launcher.log, 있다면 sfv_ember-crash-*.dmp)을 SFV Ember 팀에 보낸 뒤 다시 시도하세요."

msgid "launcher.game_crashed_sending"
msgstr "게임이 충돌했습니다. 문제 보고서 보내기가 켜져 있어 보고서를 보내는 중입니다(작은 덤프가 있으면 포함). 파일은 %APPDATA%\\SFVEmber\\logs 폴더에도 있습니다."

msgid "recovery.d3d_failed"
msgstr "복구 화면에서 Direct3D 9를 초기화하지 못했습니다. %APPDATA%\\SFVEmber\\logs\\launcher.log를 확인하세요."

msgid "recovery.choose_folder_title"
msgstr "StreetFighterV.exe가 있는 폴더(StreetFighterV\\Binaries\\Win64) 선택"

msgid "recovery.folder_invalid"
msgstr "이 폴더에는 StreetFighterV.exe가 없습니다. 게임의 StreetFighterV\\Binaries\\Win64 폴더를 선택하세요."

msgid "recovery.choose_folder_detail"
msgstr "StreetFighterV.exe가 있는 Street Fighter V 설치 폴더(게임 폴더 안의 StreetFighterV\\Binaries\\Win64)를 선택하세요. 이 패키지에는 게임 파일이 포함되지 않습니다."

msgid "recovery.close_detail"
msgstr "Street Fighter V를 시작하지 않고 복구 화면을 닫습니다. 진행 중인 작업은 취소됩니다."

msgid "updates.install_detail"
msgstr "설치 전에 Street Fighter V를 닫으세요. 설치 전에 패키지를 검증하며 개인 설정은 유지됩니다."

msgid "updates.close_detail"
msgstr "Street Fighter V를 시작하지 않고 업데이터를 닫습니다. 진행 중인 작업은 취소됩니다."

msgid "updates.start_game"
msgstr "Street Fighter V 시작"

msgid "updates.start_game_detail"
msgstr "업데이터를 닫고 SFV Ember로 Street Fighter V를 시작합니다."

msgid "services.diagnostics_saved"
msgstr "%APPDATA%\\SFVEmber\\diagnostics\\ember-diagnostics.txt에 저장했습니다"

msgid "services.update_prepared"
msgstr "업데이트 준비 완료. SFV Ember를 다시 시작합니다..."

msgid "update.no_zip_asset"
msgstr "최신 릴리스에 SFV Ember ZIP 파일이 없습니다."

msgid "update.close_sf4"
msgstr "업데이트를 설치하기 전에 Street Fighter V를 닫으세요."

msgid "update.download_failed"
msgstr "다운로드에 실패했습니다({0}). 수동 다운로드: {1} (자세한 내용은 %TEMP%\\sfv-ember-update.log를 확인하세요)"

msgid "update.missing_binaries"
msgstr "다운로드한 패키지에 Launcher.exe 또는 sfv_ember.dll이 없습니다."

msgid "update.notice.waiting_launcher"
msgstr "SFV Ember가 닫히기를 기다리는 중..."

msgid "update.notice.reopens"
msgstr "완료되면 SFV Ember가 다시 열립니다."

msgid "reports.payload"
msgstr "보고서는 embernetplay.link로 전송됩니다. 각 보고서에는 SFV Ember 버전과 빌드, Windows 버전, 충돌 정보, 개인정보를 가린 sfv_ember.log, launcher.log, sf4-net.log의 끝부분이 들어가며, 작은 덤프가 있으면 그것도 포함됩니다."

msgid "reports.history_unreadable_detail"
msgstr "%APPDATA%\\SFVEmber의 sent-reports.json을 읽을 수 없어 묻지 않고 보내는 보고서는 없습니다. 새 기록을 시작하려면 이 파일을 삭제하세요."

msgid "home.replays_detail"
msgstr "방에서 치른 대전이 끝날 때마다 저장됩니다. Street Fighter V에서 다시 시청할 수 있습니다."

msgid "replays.empty_detail"
msgstr "방에서 치른 대전이 끝나면 여기에 저장됩니다."

msgid "replays.watch_detail"
msgstr "Street Fighter V에서 대전을 처음부터 다시 재생합니다."

msgid "replays.row_detail"
msgstr "선택하여 시청하거나 보관하거나 파일을 확인하세요."

msgid "replays.open_folder_detail"
msgstr "탐색기에서 리플레이 폴더를 엽니다."

msgid "inputs.unreadable_detail"
msgstr "이 리플레이를 재생할 수 없습니다. 파일이 손상되었거나 다른 SFV Ember 빌드에서 만든 것입니다. 이유는 로그에 있습니다."

msgid "replays.not_added"
msgstr "이 리플레이는 끝까지 재생되지 않았습니다. 이유는 로그에 있습니다."

msgid "home.training_detail"
msgstr "내 파이터로 Street Fighter V의 트레이닝 모드에 들어가, 선택한 더미를 상대합니다."

msgid "room.practice.detail"
msgstr "방의 모든 게임이 연습 대전입니다. 체력과 게이지가 다시 차고 누구도 KO되지 않으며 시간 제한이 없습니다. 방이 열려 있는 동안 바뀌지 않습니다. 일반 대전을 하려면 방을 닫고 새로 만드세요."
